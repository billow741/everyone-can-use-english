# SunnyBridge Enjoy 在线版 VPS 环境变量配置示例

PORT=3000

# OpenAI 兼容大模型配置 (全面支持 DeepSeek, ChatGPT, 通义千问, Kimi, Ollama 等)
# DeepSeek 官方接口示例：https://api.deepseek.com
# OpenAI 官方接口示例：https://api.openai.com/v1
# 硅基流动 / OneAPI / NewAPI / 本地 Ollama 均可直接填入
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key-here
AI_MODEL=deepseek-chat
